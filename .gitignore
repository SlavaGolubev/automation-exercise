# ==========================================
# 1. Окружение и кэш Python
# ==========================================
# Виртуальные окружения. Они уникальны для каждой машины,
# в репозитории храним только requirements.txt или pyproject.toml.
venv/
.venv/
env/

# Скомпилированный байт-код и кэш. Git должен хранить исходники, а не мусор интерпретатора.
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# 2. Pytest и метрики
# ==========================================
# Кэш самого pytest и файлы покрытия (coverage).
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# ==========================================
# 3. Allure
# ==========================================
# Allure генерирует JSON-файлы для каждого шага. Это артефакты, а не код.
allure-results/
# Сгенерированный HTML-отчет. Его можно открыть локально или залить на CI.
allure-report/

# ==========================================
# 4. Pydantic и секреты
# ==========================================
# Pydantic (особенно pydantic-settings) часто читает переменные из .env.
# Там могут быть пароли, токены, URL тестовых стендов. Это нельзя светить.
.env
.env.*
*.local.ini

# ==========================================
# 5. Артефакты UI-автоматизации (Твои специфичные файлы)
# ==========================================
# При падении тестов Playwright/Selenium часто делают скриншоты или пишут логи.
screenshots/
logs/
downloads/
*.log
temp/

# ==========================================
# 6. Настройки IDE и ОС
# ==========================================
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
